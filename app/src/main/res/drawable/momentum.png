<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Gradientes para efectos realistas -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:1" />
    </linearGradient>
    
    <linearGradient id="arrowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00d4ff;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#0099ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0066ff;stop-opacity:1" />
    </linearGradient>
    
    <linearGradient id="glowGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#00d4ff;stop-opacity:0.6" />
      <stop offset="100%" style="stop-color:#0066ff;stop-opacity:0" />
    </linearGradient>
    
    <!-- Sombra interior -->
    <filter id="innerShadow">
      <feGaussianBlur in="SourceAlpha" stdDeviation="3"/>
      <feOffset dx="0" dy="2" result="offsetblur"/>
      <feComponentTransfer>
        <feFuncA type="linear" slope="0.5"/>
      </feComponentTransfer>
      <feMerge>
        <feMergeNode/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    
    <!-- Brillo -->
    <filter id="glow">
      <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Fondo con esquinas redondeadas (estilo iOS) -->
  <rect width="200" height="200" rx="45" fill="url(#bgGrad)" filter="url(#innerShadow)"/>
  
  <!-- Círculo de resplandor sutil -->
  <circle cx="100" cy="90" r="50" fill="url(#glowGrad)" opacity="0.3"/>
  
  <!-- Flecha principal con efecto de momentum -->
  <g filter="url(#glow)">
    <!-- Líneas de velocidad traseras -->
    <path d="M 30 100 L 50 100" stroke="url(#arrowGrad)" stroke-width="3" opacity="0.3" stroke-linecap="round"/>
    <path d="M 35 85 L 55 85" stroke="url(#arrowGrad)" stroke-width="2.5" opacity="0.25" stroke-linecap="round"/>
    <path d="M 35 115 L 55 115" stroke="url(#arrowGrad)" stroke-width="2.5" opacity="0.25" stroke-linecap="round"/>
    
    <!-- Flecha principal -->
    <path d="M 50 100 L 130 100 L 130 75 L 170 100 L 130 125 L 130 100 Z" 
          fill="url(#arrowGrad)" 
          stroke="#0099ff" 
          stroke-width="1"/>
    
    <!-- Brillo en la flecha -->
    <path d="M 60 95 L 125 95 L 125 80 L 155 100 L 125 110 L 125 95" 
          fill="rgba(255,255,255,0.2)"/>
  </g>
  
  <!-- Partículas de momentum -->
  <circle cx="45" cy="70" r="2" fill="#00d4ff" opacity="0.6"/>
  <circle cx="40" cy="130" r="2.5" fill="#0099ff" opacity="0.5"/>
  <circle cx="55" cy="95" r="1.5" fill="#00d4ff" opacity="0.7"/>
  
  <!-- Highlight sutil en la parte superior -->
  <ellipse cx="100" cy="50" rx="60" ry="20" fill="white" opacity="0.05"/>
</svg>